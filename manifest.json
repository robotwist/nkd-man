{
    "manifest_version": 3,
    "name": "Summon NK D Man",
    "version": "1.0",
    "description": "Click the extension button to unleash NK D Man onto any webpage!",
    "permissions": ["activeTab"],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_icon": "icon.png",
        "default_title": "Summon NK D Man",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": ["<all_urls>"]
}
